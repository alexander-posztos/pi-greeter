{
  "name": "pi-greeter",
  "version": "0.1.3",
  "description": "A minimal startup greeter for the Pi coding agent.",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "prepublishOnly": "npm run check"
  },
  "license": "MIT",
  "author": "Alex",
  "homepage": "https://github.com/alexander-posztos/pi-greeter#readme",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/alexander-posztos/pi-greeter.git"
  },
  "bugs": {
    "url": "https://github.com/alexander-posztos/pi-greeter/issues"
  },
  "files": [
    "extensions",
    "images",
    "README.md",
    "LICENSE",
    "pi-greeter.example.json"
  ],
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "pi-extension",
    "greeter",
    "dashboard",
    "neovim",
    "alpha-nvim"
  ],
  "pi": {
    "extensions": [
      "./extensions/greeter.ts"
    ],
    "image": "https://raw.githubusercontent.com/alexander-posztos/pi-greeter/main/images/screenshot.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.79.1",
    "@earendil-works/pi-tui": "^0.79.1",
    "@types/node": "^25.9.3",
    "typescript": "^6.0.3"
  }
}
